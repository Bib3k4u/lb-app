# =============================================================================
# LIMITBEYOND backend — environment variables.
#
# Copy to .env and fill in real values for anything you want to actually
# exercise (Twilio, Cloudinary). Everything else has a working local default
# so the app boots and the Phase 1 API surface is fully testable without any
# third-party account. NEVER commit .env — see NFR-SEC-09 / CLAUDE.md NEVER #6.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Local dev runs Postgres on 5433, not 5432 — see backend/DEV.md for why.
# lb_app owns nothing (NN-2); lb_migrator owns the schema and runs Flyway.
DB_URL=jdbc:postgresql://localhost:5433/limitbeyond
DB_USER=lb_app
DB_PASSWORD=lb_app

# Neon (or any pooled Postgres): DDL must go through a DIRECT connection, never
# through the transaction-mode pooler. Give Flyway that direct URL in every
# environment where the two differ. Locally they're the same host, so this is
# a no-op default.
DB_MIGRATION_URL=jdbc:postgresql://localhost:5433/limitbeyond
DB_MIGRATION_USER=lb_migrator
DB_MIGRATION_PASSWORD=lb_migrator

# --- Auth -----------------------------------------------------------------------
# REQUIRED before any real deployment. Generate with, e.g.:
#   openssl rand -base64 64
# Rotating this invalidates every issued access token immediately.
JWT_SECRET=

# --- Email (Resend) ---------------------------------------------------------------
# API key from resend.com (starts with re_). Leave blank to switch email off.
RESEND_API_KEY=
EMAIL_FROM=LimitBeyond by Neelkanth Gym <hello@neelkanthgym.in>
# Sender for Super Admin alerts (new gym / branch awaiting review). Any address on
# the verified domain works; no mailbox is needed.
EMAIL_FROM_ALERTS=LimitBeyond Alerts <alerts@neelkanthgym.in>
# Replies to the welcome email go here (the sender address has no inbox).
EMAIL_REPLY_TO=
CONSOLE_URL=https://admin.neelkanthgym.in

# --- Google sign-in (web console) ------------------------------------------------
# OAuth 2.0 *Web application* client ID from Google Cloud Console. Leave blank to
# keep "Sign in with Google" switched off (the endpoint then returns 503).
GOOGLE_CLIENT_ID=

# --- Twilio Verify (ADR-08) -----------------------------------------------------
# Leave blank to use the local OTP dev-mode bypass (fixed code, console-logged).
# Fill in once you have a Twilio account; DLT registration is required before
# any code can reach a real Indian mobile number — see LB-ARCH-1.0 ADR-08.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_DEV_MODE=true
OTP_DEV_MODE_CODE=123456

# --- Cloudinary (ADR-15) ---------------------------------------------------------
# Leave blank during API-only development — MediaService fails closed (503) on
# an upload attempt rather than pretending to succeed, so absence is loud.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Misc ------------------------------------------------------------------------
PORT=8080
# The web console calls this API directly from the browser, so its origin must be listed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,https://neelkanthgym.in,https://admin.neelkanthgym.in
OPENAPI_UI_ENABLED=true

# Rate limits — requests per hour per key (LB-API-1.0 §2.8). Loosened here only
# so you can load-test with autocannon; production should use the documented
# defaults (5 / 10 / 10 / 30) rather than override them.
RATE_LIMIT_OTP_REQUEST=5
RATE_LIMIT_OTP_VERIFY=10
RATE_LIMIT_SIGN_IN=10
RATE_LIMIT_CHECK_IN=30
USDA_FDC_API_KEY=
